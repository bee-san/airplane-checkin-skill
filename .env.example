# Copy to .env, fill locally, and never commit it.
ANA_RESERVATION_NUMBER=ABC123
ANA_FIRST_NAME=GIVENNAME
ANA_LAST_NAME=FAMILYNAME

# status | checkin | boarding-pass
ANA_ACTION=status

# Required only for ANA_ACTION=checkin.
# Set to YES only after the passenger personally confirms ANA's restriction.
ANA_CONFIRM_BAGGAGE_RESTRICTIONS=NO

# Optional. The script auto-detects common Chrome paths on macOS and Linux.
CHROME_EXECUTABLE=/path/to/Google Chrome
HEADLESS=false
ANA_PROFILE_DIR=.runtime/profile
ANA_ARTIFACT_DIR=artifacts
DEBUG_ARTIFACTS=false
