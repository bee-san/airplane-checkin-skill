{
  "name": "airplane-checkin-skill",
  "version": "2.0.0",
  "private": false,
  "description": "Privacy-conscious Hermes skill for scheduled, verified multi-airline check-in with a guarded ANA adapter",
  "type": "module",
  "scripts": {
    "plan": "node src/plan-cli.mjs",
    "status": "node src/ana-checkin.mjs status",
    "checkin": "node src/ana-checkin.mjs checkin",
    "boarding-pass": "node src/ana-checkin.mjs boarding-pass",
    "test": "node --test",
    "lint": "node --check src/ana-checkin.mjs && node --check src/checkin-plan.mjs && node --check src/plan-cli.mjs",
    "secret-scan": "bash scripts/secret-scan.sh"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "playwright-core": "^1.62.1"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bee-san/airplane-checkin-skill.git"
  },
  "keywords": [
    "airline",
    "airplane",
    "check-in",
    "hermes-agent",
    "playwright",
    "browser-automation",
    "travel-automation",
    "boarding-pass",
    "ana"
  ]
}
